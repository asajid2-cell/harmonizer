# CodeSniff Backend Configuration

# ============================================
# REQUIRED (for chatbot feature)
# ============================================

# Groq API Key - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here


# ============================================
# OPTIONAL (defaults provided)
# ============================================

# Server Settings (defaults to 0.0.0.0:8000)
# HOST=0.0.0.0
# PORT=8000

# Storage Location (defaults to ./storage)
# CODESCOPE_STORAGE_DIR=./storage

# Web/worker split.
# Keep enabled for the default local web process worker. Set to 0 only when
# running a separate worker process with: python scripts/run_worker.py
# CODESNIFF_WEB_RUNNER_ENABLED=1
# CODESNIFF_JOB_POLL_INTERVAL=1.0
# CODESNIFF_MAX_ACTIVE_REPOS=1
# CODESNIFF_DEEP_ENRICH_FILES_PER_RUN=1000
# CODESNIFF_DEEP_ENRICH_SECONDS_PER_RUN=30
# CODESNIFF_DEEP_ENRICH_BATCH_SIZE=250
# CODESNIFF_FULL_SOURCE_READ_MAX_BYTES=2000000
# CODESNIFF_SYMBOL_PARSE_MAX_BYTES=1000000
# CODESNIFF_SYMBOL_PARSE_MAX_LINES=20000
# CODESNIFF_SYMBOL_PARSE_MAX_LINE_CHARS=20000
# CODESNIFF_GENERIC_CHUNK_MAX_BYTES=1000000
# CODESNIFF_BOUNDED_FALLBACK_SAMPLE_BYTES=96000
# CODESNIFF_FILE_BLOB_MAX_BYTES=2000000

# Source retention for large shallow GitHub repos.
# auto prunes managed shallow GitHub checkouts above the threshold after cold
# search is durable; keep disables pruning.
# CODESNIFF_SOURCE_RETENTION_MODE=auto
# CODESNIFF_SOURCE_PRUNE_THRESHOLD_BYTES=1000000000

# Model Settings (defaults to microsoft/codebert-base)
# CODEBERT_MODEL=microsoft/codebert-base

# FAISS Index Type (defaults to HNSW)
# FAISS_INDEX_TYPE=HNSW

# Logging Level (defaults to INFO)
# LOG_LEVEL=INFO
