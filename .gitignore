# ========================================
# TOP-LEVEL PATTERNS (Apply to entire monorepo)
# ========================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Node
node_modules/
*.log
npm-debug.log*

# Testing & Reports (All generated test artifacts)
*TESTING*.md
*REPORT*.md
*DIAGNOSTIC*.md
*VERIFICATION*.md
*RESULTS*.md
*SUMMARY*.md
*FIXES*.md
MOBILE_*.md
TABLET_*.md
LAPTOP_*.md
DESKTOP_*.md

# Build artifacts
dist/
build/
*.egg-info/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Flask session files
backend/flask_session/

# Database files (handle backups manually)
backend/ourspace_data/
backend/myspace_data/
ourspace_data/
myspace_data/
!backend/ourspace_data/.gitkeep
!backend/myspace_data/.gitkeep
*.db
*.db-journal
*.db-shm
*.db-wal

# Generated audio/media
backend/uploads/
uploads/
audiobooks/
*.mp3
*.wav
*.flac
*.ogg
*.m4a
*.aac
!frontend/assets/audio/
!frontend/assets/audio/*.wav

# Analysis artifacts
backend/data/
data/
!frontend/cheatsheets/data/
!frontend/cheatsheets/data/*.txt

# JSON data files (but not config files)
backend/*.json
backend/**/*.json
!backend/package*.json
data/*.json

# Environment
.env

# Claude config
.claude/

# Playwright test artifacts
playwright-code/artifacts/
playwright-code/playwright-code/artifacts/
playwright-code/test-results/
playwright-code/plans/
playwright-code/dist/
playwright-code/node_modules/

# ===== CodeSniff specific =====
# Node modules
codesniff/frontend/node_modules/

# Python cache
codesniff/backend/app/__pycache__/
codesniff/backend/app/**/__pycache__/

# Storage and database files (runtime generated)
codesniff/backend/storage/
codesniff/backend/app/storage/__pycache__/

# Log files
codesniff/backend/*.log

# Environment files (keep example)
codesniff/backend/.env
codesniff/frontend/.env
!codesniff/backend/.env.example
!codesniff/frontend/.env.example

# Build artifacts
codesniff/frontend/dist/

# Test cache
codesniff/backend/.pytest_cache/
codesniff/backend/tests/__pycache__/

# VENPOD prototype local toolchain/build output
venpod/build/
venpod/emsdk/
venpod/tools/

# Local model/checkpoint artifacts. Publish separately if needed.
IMGEN/finetunemodel.*
VAE/**/*.pth
VAE/*.pth
