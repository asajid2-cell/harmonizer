# Flask secret used for sessions
SECRET_KEY=change-me

# Deployment security controls.
# HARMONIZER_ADMIN_TOKEN gates maintenance endpoints such as cache clears.
HARMONIZER_ADMIN_TOKEN=replace-with-a-long-random-token
HARMONIZER_ALLOWED_ORIGINS=https://harmonizerlabs.cc
HARMONIZER_FORCE_HTTPS=1
HARMONIZER_MAX_CONTENT_LENGTH=83886080
HARMONIZER_PROCESS_RATE_LIMIT=6
HARMONIZER_IMAGE_RATE_LIMIT=12
HARMONIZER_UPLOAD_RATE_LIMIT=20
HARMONIZER_AUTOCROONER_RATE_LIMIT=4
HARMONIZER_CODESNIFF_RATE_LIMIT=20

# Optional shared password for cheatsheet uploads.
# Leave blank to disable public uploads.
CHEATSHEET_PASSWORD=

# Optional OurSpace admin password.
# Leave blank to initialize fresh local databases with an unprinted random admin password.
OURSPACE_ADMIN_PASSWORD=

# Spotify API credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Access token for SoundCloud/YouTube fallbacks (optional)
YOUTUBE_API_KEY=

# Local audiobook library for Night Library.
# NIGHT_LIBRARY_DIR defaults to ./audiobooks when blank.
NIGHT_LIBRARY_DIR=
# Optional single audiobook file to pin first in Night Library.
NIGHT_LIBRARY_FILE=

# Google OAuth download flow (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini (Talk to Disco-teque)
GEMINI_API_KEY=
# Optional: override the default Gemini model (gemini-2.0-flash-lite-preview)
GEMINI_MODEL=

# Groq API (Talk to Disco-teque - alternative model provider)
GROQ_API_KEY=

# CodeSniff indexing worker mode.
# Keep 1 for the default single-container web worker.
# Set to 0 only when running the Compose profile: docker compose --profile codesniff-worker up -d
CODESNIFF_WEB_RUNNER_ENABLED=1
CODESNIFF_MAX_ACTIVE_REPOS=1
CODESNIFF_JOB_POLL_INTERVAL=1.0
CODESNIFF_DEEP_ENRICH_FILES_PER_RUN=1000
CODESNIFF_DEEP_ENRICH_SECONDS_PER_RUN=30
CODESNIFF_DEEP_ENRICH_BATCH_SIZE=250
CODESNIFF_FULL_SOURCE_READ_MAX_BYTES=2000000
CODESNIFF_SYMBOL_PARSE_MAX_BYTES=1000000
CODESNIFF_SYMBOL_PARSE_MAX_LINES=20000
CODESNIFF_SYMBOL_PARSE_MAX_LINE_CHARS=20000
CODESNIFF_GENERIC_CHUNK_MAX_BYTES=1000000
CODESNIFF_BOUNDED_FALLBACK_SAMPLE_BYTES=96000
CODESNIFF_FILE_BLOB_MAX_BYTES=2000000
CODESNIFF_SOURCE_RETENTION_MODE=auto
CODESNIFF_SOURCE_PRUNE_THRESHOLD_BYTES=1000000000
