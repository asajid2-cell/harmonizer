# Flask secret used for sessions
SECRET_KEY=change-me

# Optional shared password for cheatsheet uploads.
# Leave blank to disable public uploads.
CHEATSHEET_PASSWORD=

# Optional OurSpace admin password.
# Leave blank to initialize fresh local databases with an unprinted random admin password.
OURSPACE_ADMIN_PASSWORD=

# Spotify API credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Access token for SoundCloud/YouTube fallbacks (optional)
YOUTUBE_API_KEY=

# Google OAuth download flow (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini (Talk to Disco-teque)
GEMINI_API_KEY=
# Optional: override the default Gemini model (gemini-2.0-flash-lite-preview)
GEMINI_MODEL=

# Groq API (Talk to Disco-teque - alternative model provider)
GROQ_API_KEY=
