# hl-auth configuration — copy to .env and fill in. NEVER commit the real .env.

# HTTP
PORT=4200
# Public base path the service is mounted under in nginx (so generated links are correct).
# Served at https://harmonizerlabs.cc/auth  ->  BASE_PATH=/auth
BASE_PATH=/auth

# Cookie
# The host the session cookie is scoped to. All properties must live under this host
# for SSO to work. Leave COOKIE_DOMAIN empty for a host-only cookie (recommended).
COOKIE_NAME=hl_session
COOKIE_DOMAIN=
# Set to 1 in production (HTTPS). 0 only for local http testing.
COOKIE_SECURE=1
# Session lifetime (sliding), days.
SESSION_TTL_DAYS=90
# Invite code lifetime, hours.
INVITE_TTL_HOURS=24

# Storage
DB_PATH=./data/hl-auth.db

# First-run bootstrap (only used when the DB is empty).
# An admin account is created with this username + password.
BOOTSTRAP_ADMIN_USERNAME=owner
BOOTSTRAP_ADMIN_PASSWORD=change-me-now-long-random
# The master backdoor password (root, universal, owner-only). High entropy.
# If empty, no master backdoor is configured (you can set it later in the admin panel).
MASTER_PASSWORD=change-me-too-very-long-random

# Pages registry seed (comma-separated id:label:pathPrefix). Used only on first run.
SEED_PAGES=cloud-squeeze:Cloud Squeeze:/cloud-squeeze,watch-together:Watch Together:/mediamtx,main:Main Site:/

# Optional shared secret that integrating apps must send as the X-Internal-Key header
# when calling /internal/verify. Defense-in-depth (nginx already never routes /internal).
INTERNAL_KEY=

# Trust the X-Forwarded-* headers from nginx (needed for correct IP + https detection).
TRUST_PROXY=1
